# AI-Driven Issue Resolution System Environment Variables

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_PRIVATE_KEY=path/to/private-key.pem
GITHUB_REPOSITORY=owner/repo

# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# System Configuration
AUTOMATION_ENV=dev  # dev, staging, production
MAX_CONCURRENT_ISSUES=5
MAX_PR_PER_DAY=50

# Security Settings
ENABLE_SECURITY_SCANNING=true
BLOCK_ON_SECURITY_ISSUES=true

# Notification Settings (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ENABLE_SLACK_NOTIFICATIONS=false

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=ai-bot@example.com
EMAIL_TO=team@example.com

# Observability (Optional)
ENABLE_DETAILED_LOGGING=true
LOG_LEVEL=INFO
METRICS_ENABLED=false
METRICS_ENDPOINT=

# Feature Flags
ENABLE_ITERATIVE_FIXES=true
ENABLE_AUTO_GENERATE_TESTS=true
ENABLE_INTEGRATION_TESTS=false
ENABLE_AI_CODE_REVIEW=true

# Rate Limiting
MAX_ISSUES_PER_HOUR=10
MIN_RETRY_INTERVAL_SECONDS=300

# Review Settings
REQUIRED_APPROVALS=1
AUTO_MERGE_ENABLED=false
MAX_FIX_ITERATIONS=3
REVIEW_REMINDER_HOURS=24
